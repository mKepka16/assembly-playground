{
  "customLocalFormatters.formatters": [
    {
      "command": "python3 scripts/asmfmt.py -",
      "languages": ["arm"]
    }
  ],
  "[arm]": {
    "editor.defaultFormatter": "jkillian.custom-local-formatters",
    "editor.formatOnSave": true
  },
  "editor.tabSize": 8,
  "files.associations": {
    "*.inc": "arm"
  }
}
